{
  "name": "@mikepage/flareosaur",
  "version": "20261010.0.2",
  "license": "MIT",
  "exports": {
    "./assert": "./assert/mod.ts",
    "./bytes": "./bytes/mod.ts",
    "./internal/inspect": "./internal/Inspect.ts",
    "./internal": "./internal/mod.ts",
    "./regexp": "./regexp/mod.ts",
    "./testing/test": "./testing/Test.ts",
    "./testing": "./testing/mod.ts",
    "./yaml": "./yaml/mod.ts"
  },
  "imports": {
    "effect": "npm:effect@^4.0.2"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "types": [
      "./types/web.d.ts",
      "./types/wasm.d.ts"
    ]
  },
  "exclude": [
    ".git",
    "node_modules",
    "scripts",
    "types"
  ],
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "ulid/test.ts",
      "**/testdata/",
      "**/_test_utils.ts",
      "**/_test_util.ts",
      "internal/_testing.ts",
      "package.json",
      "package-lock.json",
      "patches/",
      ".github/"
    ]
  }
}
