{
  "name": "@mikepage/flareosaur",
  "version": "20261010.0.2",
  "license": "MIT",
  "exports": {
    "./assert": "./assert/mod.ts",
    "./http/cache-control": "./http/CacheControl.ts",
    "./http/etag": "./http/Etag.ts",
    "./http/form-data": "./http/FormData.ts",
    "./http/header": "./http/Header.ts",
    "./http/message-signatures": "./http/MessageSignatures.ts",
    "./http/method": "./http/Method.ts",
    "./http/negotiation": "./http/Negotiation.ts",
    "./http/problem-details": "./http/ProblemDetails.ts",
    "./http/route": "./http/Route.ts",
    "./http/server-sent-events": "./http/ServerSentEvents.ts",
    "./http/signed-cookie": "./http/SignedCookie.ts",
    "./http/status": "./http/Status.ts",
    "./http/structured-fields": "./http/StructuredFields.ts",
    "./http/user-agent": "./http/UserAgent.ts",
    "./http": "./http/mod.ts",
    "./internal/inspect": "./internal/Inspect.ts",
    "./internal": "./internal/mod.ts",
    "./media-types": "./media_types/mod.ts",
    "./testing/test": "./testing/Test.ts",
    "./testing": "./testing/mod.ts",
    "./yaml": "./yaml/mod.ts"
  },
  "imports": {
    "effect": "npm:effect@^4.0.2"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "types": [
      "./types/web.d.ts",
      "./types/wasm.d.ts"
    ]
  },
  "exclude": [
    ".git",
    "node_modules",
    "scripts",
    "types"
  ],
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "ulid/test.ts",
      "**/testdata/",
      "**/_test_utils.ts",
      "**/_test_util.ts",
      "internal/_testing.ts",
      "package.json",
      "package-lock.json",
      "patches/",
      ".github/"
    ]
  }
}
