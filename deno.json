{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "types": [
      "./types/web.d.ts",
      "./types/wasm.d.ts"
    ]
  },
  "exclude": [
    ".git",
    "node_modules",
    "scripts",
    "types"
  ],
  "workspace": [
    "./assert",
    "./async",
    "./bytes",
    "./cache",
    "./collections",
    "./crypto",
    "./csv",
    "./data_structures",
    "./datetime",
    "./dotenv",
    "./encoding",
    "./fmt",
    "./front_matter",
    "./html",
    "./http",
    "./internal",
    "./json",
    "./jsonc",
    "./media_types",
    "./path",
    "./regexp",
    "./semver",
    "./streams",
    "./testing",
    "./text",
    "./toml",
    "./ulid",
    "./uuid",
    "./yaml"
  ]
}
