+    if (level > ctx.depth) return `[${name ?? "Set"}]`;
+    ctx.currentDepth = level;
+    output = formatList(
+      obj,
+      obj.size,
+      ctx,
+      (v) => formatValue(v, ctx, level + 1, true),
