+  }
+  const ln = base === "" && braces[0].length === 1
+    ? " "
+    : `${base ? ` ${base}` : ""}\n  `;
+  return `${braces[0]}${ln}${output.map(indentLines).join(",\n  ")} ${
+    braces[1]
